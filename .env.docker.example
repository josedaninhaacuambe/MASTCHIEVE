# Mastchieve IA — variáveis do docker-compose.prod.yml
#
# Copiar para ".env" (raiz do repo, já está no .gitignore) e preencher com
# senhas fortes e reais. NUNCA commitar o ficheiro ".env" preenchido.
#
# As variáveis NEXT_PUBLIC_* usadas no build da imagem Web NÃO vão aqui —
# são extraídas automaticamente de apps/web/.env.production pelos scripts
# deploy/setup-vps-docker.sh e deploy/deploy-docker.sh.

MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=mastchieve_prod
MYSQL_USER=mastchieve_user
MYSQL_PASSWORD=troque_esta_senha
REDIS_PASSWORD=troque_esta_senha_redis
