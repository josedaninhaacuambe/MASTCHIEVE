generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String    @db.VarChar(255)
  role         String // ADMIN | SUPERVISOR | INSTRUCTOR | COORDINATOR | STUDENT | PARENT | MARKETING | VISITOR | GESTOR_RH | SUPER_ADMIN
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  refreshToken String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  admin                 Admin?
  instructor            Instructor?
  student               Student?
  parent                Parent?
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  auditLogs             AuditLog[]
  incidentesReportados  Incidente[]         @relation("IncidenteReportado")
  pedidosComunicacao    PedidoComunicacao[] @relation("PedidoSolicitante")
  pedidosAprovados      PedidoComunicacao[] @relation("PedidoAprovado")
  certificadosValidados Certificado[]

  funcionario                 Funcionario?
  vagasSolicitadas            Vaga[]                  @relation("VagaSolicitante")
  vagasAprovadas              Vaga[]                  @relation("VagaAprovada")
  candidaturasAvaliadas       Candidatura[]           @relation("CandidaturaAvaliada")
  candidaturasAprovadas       Candidatura[]           @relation("CandidaturaAprovada")
  contratosElaborados         Contrato[]              @relation("ContratoElaborado")
  contratosAssinados          Contrato[]              @relation("ContratoAssinado")
  avaliacoesDesempenho        AvaliacaoDesempenho[]
  feriasFaltasSolicitadas     FeriasFalta[]           @relation("FeriasSolicitante")
  feriasFaltasAprovadas       FeriasFalta[]           @relation("FeriasAprovada")
  folhaPagamentosProcessadas  FolhaPagamento[]        @relation("FolhaProcessada")
  folhaPagamentosAprovadas    FolhaPagamento[]        @relation("FolhaAprovada")
  ocorrenciasRegistadas       OcorrenciaDisciplinar[] @relation("OcorrenciaRegistada")
  ocorrenciasDecididas        OcorrenciaDisciplinar[] @relation("OcorrenciaDecidida")
  formacoesPropostas          Formacao[]              @relation("FormacaoProposta")
  formacoesAprovadas          Formacao[]              @relation("FormacaoAprovada")
  desligamentosIniciados      Desligamento[]          @relation("DesligamentoIniciado")
  desligamentosAprovados      Desligamento[]          @relation("DesligamentoAprovado")
  documentosRHValidados       DocumentoRH[]
  dispositivosQuiosqueCriados DispositivoQuiosque[]   @relation("DispositivoCriado")
  presencasLancadas           RegistoPresenca[]       @relation("PresencaLancadaManualmente")

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ─── Instructor ───────────────────────────────────────────────────────────────

model Instructor {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  specializations String   @db.Text
  bio             String?  @db.Text
  isActive        Boolean  @default(true)
  hireDate        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes                      Class[]
  attendances                  Attendance[]
  feedbacks                    Feedback[]
  trainingPlans                TrainingPlan[]
  avaliacoesIniciais           AvaliacaoInicial[]
  unidades                     InstructorUnidade[]
  checklistsProtocolo          ChecklistProtocolo[]
  funcionario                  Funcionario?
  athleteReports               AthleteReport[]
  avaliacoesAgendadas          AvaliacaoAgendada[]
  avaliacoesAgendadasAvaliadas Avaliacao[]

  @@index([isActive])
  @@map("instructors")
}

// ─── Student ─────────────────────────────────────────────────────────────────

model Student {
  id                    String    @id @default(uuid())
  userId                String    @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String    @default("OTHER")
  phone                 String?
  avatarUrl             String?
  medicalNotes          String?   @db.Text
  emergencyContact      String?
  emergencyPhone        String?
  enrollmentDate        DateTime  @default(now())
  isActive              Boolean   @default(true)
  unidadeId             String?
  autorizacaoImagem     Boolean   @default(false)
  autorizacaoImagemData DateTime?
  autorizacaoImagemDoc  String?
  leadId                String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unidade             Unidade?                     @relation(fields: [unidadeId], references: [id])
  lead                Lead?                        @relation(fields: [leadId], references: [id])
  parents             StudentParent[]
  enrollments         Enrollment[]
  attendances         Attendance[]
  feedbacks           Feedback[]
  progressRecords     Progress[]
  studentFases        StudentFase[]
  certificados        Certificado[]
  trainingPlans       TrainingPlan[]
  payments            Payment[]
  monthlyFees         MonthlyFee[]
  documents           Document[]
  avaliacaoInicial    AvaliacaoInicial?
  competicoes         CompeticaoAtleta[]
  athleteReports      AthleteReport[]
  avaliacoesAgendadas Avaliacao[]

  @@index([isActive])
  @@index([unidadeId])
  @@map("students")
}

// ─── Athlete Report (relatório mensal + chamada de atenção) ──────────────────

model AthleteReport {
  id             String    @id @default(uuid())
  studentId      String
  instructorId   String?
  tipo           String // MENSAL | CHAMADA_ATENCAO
  referenceMonth String? // "2026-08", só para MENSAL
  mensagem       String?   @db.Text // nota do instrutor, obrigatória para CHAMADA_ATENCAO
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@index([studentId])
  @@index([tipo])
  @@map("athlete_reports")
}

// ─── Parent ───────────────────────────────────────────────────────────────────

model Parent {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  phone        String
  relationship String   @default("Parent")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children StudentParent[]

  @@map("parents")
}

model StudentParent {
  studentId String
  parentId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@map("student_parents")
}

// ─── Unidade (Multi-Unit) ────────────────────────────────────────────────────

model Unidade {
  id        String   @id @default(uuid())
  nome      String
  codigo    String   @unique // CCBM | OSCARS | POLANA
  tipo      String   @default("PRINCIPAL") // PRINCIPAL | COMUNITARIO | PREMIUM
  endereco  String?
  contacto  String?
  email     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turmas               Class[]
  estudantes           Student[]
  instrutores          InstructorUnidade[]
  leads                Lead[]
  incidentes           Incidente[]
  eventos              Evento[]
  competicoes          Competicao[]
  funcionarios         Funcionario[]
  vagas                Vaga[]
  escalas              Escala[]
  dispositivosQuiosque DispositivoQuiosque[]
  presencasBiometricas RegistoPresenca[]

  @@map("unidades")
}

model InstructorUnidade {
  id          String   @id @default(uuid())
  instrutorId String
  unidadeId   String
  isPrimary   Boolean  @default(false)
  criadoEm    DateTime @default(now())

  instrutor Instructor @relation(fields: [instrutorId], references: [id], onDelete: Cascade)
  unidade   Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([instrutorId, unidadeId])
  @@map("instructor_unidades")
}

// ─── Lead / CRM ──────────────────────────────────────────────────────────────

model Lead {
  id              String    @id @default(uuid())
  nome            String
  email           String?
  telefone        String?
  origem          String    @default("OUTRO") // REFERIDO|REDES_SOCIAIS|OPEN_DAY|WALK_IN|WEBSITE|CAMPANHA|OUTRO
  campanha        String?
  estado          String    @default("NOVO") // NOVO|CONTACTADO|AGENDADO|CONVERTIDO|PERDIDO
  unidadeId       String?
  eventoId        String?
  notas           String?   @db.Text
  dataContacto    DateTime?
  dataAgendamento DateTime?
  dataConversao   DateTime?
  motivoPerda     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  unidade Unidade? @relation(fields: [unidadeId], references: [id])
  evento  Evento?  @relation(fields: [eventoId], references: [id])
  student Student?

  @@index([estado])
  @@index([unidadeId])
  @@map("leads")
}

// ─── Avaliação Inicial ────────────────────────────────────────────────────────

model AvaliacaoInicial {
  id                    String    @id @default(uuid())
  studentId             String    @unique
  instrutorId           String
  data                  DateTime  @default(now())
  experienciaAquatica   Int       @default(1) // 1-5
  segurancaAdaptacao    Int       @default(1) // 1-5
  confortoAgua          Int       @default(1) // 1-5
  resistenciaBasica     Int       @default(1) // 1-5
  criteriosAvaliados    String    @db.Text // JSON: [{fase,criterio,valor}]
  necessidadesEspeciais String?   @db.Text
  observacoes           String?   @db.Text
  faseRecomendadaId     String?
  aprovadoPorId         String?
  aprovadoEm            DateTime?
  createdAt             DateTime  @default(now())

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instrutor       Instructor      @relation(fields: [instrutorId], references: [id])
  faseRecomendada FaseProgressao? @relation(fields: [faseRecomendadaId], references: [id])

  @@map("avaliacoes_iniciais")
}

// ─── Módulos de Progressão (9 módulos com animais, agrupados em 3 fases) ─────
// Nota de terminologia (ficha técnica oficial): FASE = nivel (AMA/INTERMEDIARIO/AVANCADO),
// MÓDULO = cada linha desta tabela (nível-animal, 3 por fase). O nome do modelo
// mantém-se `FaseProgressao` por compatibilidade de schema/BD, mas conceptualmente
// representa um MÓDULO.

model FaseProgressao {
  id           String   @id @default(uuid())
  nivel        String // FASE: AMA | INTERMEDIARIO | AVANCADO
  ordem        Int
  nome         String // Estrela-do-Mar, Cavalo-Marinho, etc. (nome do MÓDULO)
  animal       String
  certificacao String // BRONZE | PRATA | OURO
  descricao    String?  @db.Text
  foco         String?  @db.Text // foco pedagógico do módulo
  escala       String   @db.Text // JSON: ["1 - Péssimo","2 - Fraco","3 - Razoável","4 - Bom","5 - Excelente"]
  criterios    String   @db.Text // JSON: { nome: string; obrigatoria: boolean }[] — obrigatoria=true exige mínimo 4, geral exige mínimo 3
  totalMinimo  Int      @default(0) // soma mínima acumulada das pontuações das habilidades para concluir o módulo
  assiduidade  Int      @default(80) // minimum attendance % required
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  studentFases       StudentFase[]
  certificados       Certificado[]
  avaliacoesIniciais AvaliacaoInicial[]

  @@unique([nivel, ordem])
  @@map("fases_progressao")
}

model StudentFase {
  id          String    @id @default(uuid())
  studentId   String
  faseId      String
  estado      String    @default("NAO_INICIADO") // NAO_INICIADO|EM_PROGRESSO|CONCLUIDO
  iniciadoEm  DateTime?
  concluidoEm DateTime?
  pontuacao   Float?
  notas       String?   @db.Text
  updatedAt   DateTime  @updatedAt

  student             Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fase                FaseProgressao         @relation(fields: [faseId], references: [id])
  avaliacoes          StudentFaseCriterio[]
  avaliacoesAgendadas Avaliacao[]

  @@unique([studentId, faseId])
  @@index([studentId])
  @@map("student_fases")
}

// Pontuação (1-5) de cada habilidade de um módulo, por aluno. criterioIndex indexa
// posicionalmente o array FaseProgressao.criterios — nunca reordenar esse array
// depois de existirem avaliações.
model StudentFaseCriterio {
  id            String   @id @default(uuid())
  studentFaseId String
  criterioIndex Int
  valor         Int // 1-5
  observacao    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentFase StudentFase @relation(fields: [studentFaseId], references: [id], onDelete: Cascade)

  @@unique([studentFaseId, criterioIndex])
  @@map("student_fase_criterios")
}

// ─── Avaliações Agendadas (sessões formais de avaliação por turma) ──────────
// O instrutor marca um dia para avaliar formalmente os atletas de uma turma,
// usando a mesma regra de aprovação da "avaliação final" (ver
// regra-conclusao.util.ts). O resultado decide a transição de módulo.
model AvaliacaoAgendada {
  id           String   @id @default(uuid())
  instructorId String
  classId      String
  data         DateTime
  estado       String   @default("AGENDADA") // AGENDADA | EM_ANDAMENTO | CONCLUIDA | CANCELADA
  observacoes  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor Instructor @relation(fields: [instructorId], references: [id])
  class      Class      @relation(fields: [classId], references: [id])
  resultados Avaliacao[]

  @@index([instructorId])
  @@index([classId])
  @@map("avaliacoes_agendadas")
}

// Avaliação unificada: cobre tanto a avaliação DIÁRIA (por aula, gera feedback IA,
// nunca transita módulo) como a avaliação AGENDADA (sessão formal por turma, decide
// a transição de módulo). Ambas pontuam os mesmos critérios do módulo ativo do aluno
// (ver regra-conclusao.util.ts) — só o que é FEITO com o resultado difere por tipo.
// Snapshot imutável — preserva histórico completo (incl. reprovações) sem sobrescrever.
model Avaliacao {
  id                  String   @id @default(uuid())
  tipo                String // DIARIA | AGENDADA
  sessaoAgendadaId    String? // obrigatório apenas quando tipo=AGENDADA
  classSessionId      String? // contexto opcional da aula, usado sobretudo em DIARIA
  studentId           String
  studentFaseId       String
  pontuacoes          String   @db.Text // JSON: [{criterioIndex,nome,obrigatoria,valor,minimo}]
  soma                Int
  totalMinimoSnapshot Int
  notaGlobal          Float // soma normalizada 0-10 = (soma / (nº critérios * 5)) * 10
  aprovado            Boolean // sempre calculado; só aciona transição de módulo quando tipo=AGENDADA
  motivoReprovacao    String?  @db.Text
  observacoes         String?  @db.Text
  avaliadoPorId       String?
  avaliadoEm          DateTime @default(now())

  sessaoAgendada AvaliacaoAgendada? @relation(fields: [sessaoAgendadaId], references: [id], onDelete: Cascade)
  classSession   ClassSession?      @relation(fields: [classSessionId], references: [id])
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFase    StudentFase        @relation(fields: [studentFaseId], references: [id])
  avaliadoPor    Instructor?        @relation(fields: [avaliadoPorId], references: [id])
  feedback       Feedback?

  @@unique([sessaoAgendadaId, studentId])
  @@index([studentId])
  @@index([studentFaseId])
  @@index([tipo])
  @@map("avaliacoes")
}

model Certificado {
  id            String   @id @default(uuid())
  studentId     String
  faseId        String
  dataEmissao   DateTime @default(now())
  validadoPorId String
  eventoId      String?
  numeroSerie   String   @unique
  observacoes   String?  @db.Text
  createdAt     DateTime @default(now())

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fase        FaseProgressao @relation(fields: [faseId], references: [id])
  validadoPor User           @relation(fields: [validadoPorId], references: [id])
  evento      Evento?        @relation(fields: [eventoId], references: [id])

  @@index([studentId])
  @@map("certificados")
}

// ─── Classes ─────────────────────────────────────────────────────────────────

model Class {
  id           String   @id @default(uuid())
  name         String
  description  String?  @db.Text
  level        String   @default("BEGINNER")
  status       String   @default("ACTIVE")
  maxStudents  Int      @default(15)
  poolLane     String?
  schedules    String   @db.Text
  instructorId String
  unidadeId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor          Instructor          @relation(fields: [instructorId], references: [id])
  unidade             Unidade?            @relation(fields: [unidadeId], references: [id])
  enrollments         Enrollment[]
  sessions            ClassSession[]
  avaliacoesAgendadas AvaliacaoAgendada[]

  @@index([status])
  @@index([instructorId])
  @@index([unidadeId])
  @@map("classes")
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  classId    String
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)
  notes      String?  @db.Text

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([isActive])
  @@map("enrollments")
}

// ─── Class Sessions & Attendance ─────────────────────────────────────────────

model ClassSession {
  id                    String   @id @default(uuid())
  classId               String
  sessionDate           DateTime
  startTime             String
  endTime               String
  notes                 String?  @db.Text
  topic                 String?
  checklistEquipamentos Boolean  @default(false)
  checklistSeguranca    Boolean  @default(false)
  createdAt             DateTime @default(now())

  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  feedbacks   Feedback[]
  checklists  ChecklistProtocolo[]
  avaliacoes  Avaliacao[]

  @@index([classId])
  @@map("class_sessions")
}

model Attendance {
  id           String   @id @default(uuid())
  sessionId    String
  studentId    String
  instructorId String
  status       String   @default("PRESENT")
  notes        String?  @db.Text
  markedAt     DateTime @default(now())

  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor   @relation(fields: [instructorId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendances")
}

// ─── Performance & Feedback ──────────────────────────────────────────────────

model PerformanceRecord {
  id              String   @id @default(uuid())
  studentId       String
  sessionId       String?
  instructorId    String?
  technique       Int?
  stamina         Int?
  speed           Int?
  coordination    Int?
  breathing       Int?
  turns           Int?
  startDive       Int?
  overallScore    Float?
  instructorNotes String?  @db.Text
  acaoCorretiva   String?  @db.Text
  rawData         String?  @db.Text
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  feedback Feedback?

  @@index([studentId])
  @@map("performance_records")
}

model Feedback {
  id                   String    @id @default(uuid())
  studentId            String
  sessionId            String?
  instructorId         String?
  performanceRecordId  String?   @unique
  avaliacaoId          String?   @unique
  status               String    @default("PENDING")
  aiGeneratedText      String?   @db.LongText
  instructorNotes      String?   @db.Text
  finalText            String?   @db.LongText
  recommendedLessons   String    @db.Text
  interactiveExercises String    @db.Text
  sentToParentAt       DateTime?
  sentToStudentAt      DateTime?
  aiModel              String?
  aiTokensUsed         Int?
  aiConfidenceScore    Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session           ClassSession?      @relation(fields: [sessionId], references: [id])
  instructor        Instructor?        @relation(fields: [instructorId], references: [id])
  performanceRecord PerformanceRecord? @relation(fields: [performanceRecordId], references: [id])
  avaliacao         Avaliacao?         @relation(fields: [avaliacaoId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("feedbacks")
}

// ─── Progress & Modules ──────────────────────────────────────────────────────

model SwimmingModule {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  level       String   @default("BEGINNER")
  order       Int
  skills      String   @db.Text
  videos      String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  progress Progress[]

  @@map("swimming_modules")
}

model Progress {
  id          String    @id @default(uuid())
  studentId   String
  moduleId    String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  score       Float?
  notes       String?   @db.Text
  updatedAt   DateTime  @updatedAt

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  SwimmingModule @relation(fields: [moduleId], references: [id])

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@map("progress")
}

// ─── Training Plans ───────────────────────────────────────────────────────────

model TrainingPlan {
  id           String    @id @default(uuid())
  studentId    String
  instructorId String?
  title        String
  description  String?   @db.Text
  objectives   String    @db.Text
  exercises    String    @db.Text
  aiGenerated  Boolean   @default(false)
  isActive     Boolean   @default(true)
  validFrom    DateTime
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@index([studentId])
  @@map("training_plans")
}

// ─── Financial ───────────────────────────────────────────────────────────────

model MonthlyFee {
  id          String   @id @default(uuid())
  studentId   String
  month       Int
  year        Int
  amount      Float
  dueDate     DateTime
  description String?
  createdAt   DateTime @default(now())

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment Payment?

  @@unique([studentId, month, year])
  @@index([studentId])
  @@map("monthly_fees")
}

model Payment {
  id            String    @id @default(uuid())
  studentId     String
  monthlyFeeId  String?   @unique
  amount        Float
  method        String    @default("CASH")
  status        String    @default("PENDING")
  reference     String?
  receiptNumber String?   @unique
  notes         String?   @db.Text
  paidAt        DateTime?
  dueDate       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthlyFee MonthlyFee? @relation(fields: [monthlyFeeId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("payments")
}

// ─── Protocolos de Segurança (SOP 09 — Documento Consolidado Jun/2026) ────────

model Protocolo {
  id               String   @id @default(uuid())
  ranking          Int      @unique // 1–10 (prioridade oficial)
  nome             String
  dimensao         String // FISICA|OPERACIONAL|EMOCIONAL|PEDAGOGICA|GESTAO
  prioridade       String // CRITICO|MUITO_ALTO|ALTO|ESTRUTURANTE
  justificacao     String   @db.Text
  objetivo         String   @db.Text
  momentoAplicacao String   @db.Text
  responsavel      String
  procedimento     String   @db.Text
  checklistItems   String   @db.Text // JSON string[]
  sinaisAlerta     String   @db.Text // JSON string[]
  acaoFalha        String   @db.Text
  isRelampago      Boolean  @default(false) // true só no Protocolo 1
  isAtivo          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  incidentes Incidente[]
  checklists ChecklistProtocolo[]

  @@index([ranking])
  @@index([dimensao])
  @@map("protocolos")
}

model ChecklistProtocolo {
  id          String   @id @default(uuid())
  protocoloId String
  sessionId   String?
  instrutorId String
  items       String   @db.Text // JSON [{texto, checked}]
  completado  Boolean  @default(false)
  data        DateTime @default(now())
  observacoes String?  @db.Text
  createdAt   DateTime @default(now())

  protocolo Protocolo     @relation(fields: [protocoloId], references: [id])
  session   ClassSession? @relation(fields: [sessionId], references: [id])
  instrutor Instructor    @relation(fields: [instrutorId], references: [id])

  @@index([protocoloId])
  @@index([instrutorId])
  @@map("checklists_protocolo")
}

// ─── Gestão de Incidentes e Segurança (SOP 09) ───────────────────────────────

model Incidente {
  id               String    @id @default(uuid())
  unidadeId        String?
  data             DateTime  @default(now())
  tipo             String // ACIDENTE_MENOR|ACIDENTE_GRAVE|NEAR_MISS|COMPORTAMENTO|EQUIPAMENTO|INSTALACOES|OUTRO
  tipoOcorrencia   String    @default("INCIDENTE_CONFIRMADO") // INCIDENTE_CONFIRMADO|QUASE_INCIDENTE
  dimensoes        String    @db.Text // JSON: EMOCIONAL|OPERACIONAL|FISICA|PEDAGOGICA
  protocoloId      String?
  isRelampago      Boolean   @default(false)
  escalado         Boolean   @default(false)
  descricao        String    @db.Text
  envolvidos       String    @db.Text // JSON
  acaoImediata     String    @db.Text
  relatorio        String?   @db.Text
  acoesPreventivas String?   @db.Text
  estado           String    @default("REPORTADO") // REPORTADO|EM_INVESTIGACAO|RESOLVIDO|FECHADO
  reportadoPorId   String
  resolvidoEm      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  unidade      Unidade?   @relation(fields: [unidadeId], references: [id])
  reportadoPor User       @relation("IncidenteReportado", fields: [reportadoPorId], references: [id])
  protocolo    Protocolo? @relation(fields: [protocoloId], references: [id])

  @@index([estado])
  @@index([unidadeId])
  @@index([tipoOcorrencia])
  @@index([protocoloId])
  @@map("incidentes")
}

// ─── Eventos / Open Day (SOP 07) ─────────────────────────────────────────────

model Evento {
  id         String   @id @default(uuid())
  tipo       String   @default("OPEN_DAY") // OPEN_DAY|COMPETICAO|OUTRO
  nome       String
  data       DateTime
  unidadeId  String?
  programa   String?  @db.Text
  capacidade Int?
  estado     String   @default("PLANEADO") // PLANEADO|REALIZADO|CANCELADO
  notas      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unidade      Unidade?      @relation(fields: [unidadeId], references: [id])
  certificados Certificado[]
  leads        Lead[]

  @@index([tipo])
  @@index([estado])
  @@map("eventos")
}

// ─── Competições (SOP 08) ─────────────────────────────────────────────────────

model Competicao {
  id               String   @id @default(uuid())
  nome             String
  data             DateTime
  local            String
  unidadeId        String?
  descricao        String?  @db.Text
  planoCompetitivo String?  @db.Text
  estado           String   @default("PLANEADA") // PLANEADA|REALIZADA|CANCELADA
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unidade Unidade?           @relation(fields: [unidadeId], references: [id])
  atletas CompeticaoAtleta[]

  @@index([estado])
  @@map("competicoes")
}

model CompeticaoAtleta {
  id           String  @id @default(uuid())
  competicaoId String
  studentId    String
  prova        String?
  resultado    String?
  posicao      Int?
  notas        String? @db.Text

  competicao Competicao @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([competicaoId, studentId])
  @@map("competicao_atletas")
}

// ─── Pedidos de Comunicação / Marketing (SOP 9.3–9.7) ────────────────────────

model PedidoComunicacao {
  id            String    @id @default(uuid())
  tipo          String // POSTER|VIDEO|NEWSLETTER|REDES_SOCIAIS|CATALOGO|OUTRO
  titulo        String
  descricao     String    @db.Text
  unidadeId     String?
  prazo         DateTime
  estado        String    @default("RASCUNHO") // RASCUNHO|EM_APROVACAO|APROVADO|PUBLICADO|CANCELADO
  solicitanteId String
  aprovadoPorId String?
  aprovadoEm    DateTime?
  link          String?
  observacoes   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  solicitante User  @relation("PedidoSolicitante", fields: [solicitanteId], references: [id])
  aprovadoPor User? @relation("PedidoAprovado", fields: [aprovadoPorId], references: [id])

  @@index([estado])
  @@map("pedidos_comunicacao")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("INFO")
  title     String
  body      String    @db.Text
  data      String?   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─── Push Subscriptions ──────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @db.VarChar(2048)
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint(length: 191)])
  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(uuid())
  studentId  String
  name       String
  type       String
  url        String
  size       Int?
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("documents")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValues String?  @db.Text
  newValues String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

// ─── KPI Snapshots ───────────────────────────────────────────────────────────

model KpiSnapshot {
  id                     String   @id @default(uuid())
  unidadeId              String?
  snapshotDate           DateTime @default(now())
  totalStudents          Int
  activeStudents         Int
  totalInstructors       Int
  totalClasses           Int
  attendanceRate         Float
  avgFeedbackScore       Float?
  npsScore               Float?
  instructorAdoptionRate Float?
  overduePayments        Int
  monthlyRevenue         Float?
  leadsGerados           Int?
  conversaoLead          Float?
  incidentesCount        Int      @default(0)
  participacaoOpenDay    Float?
  createdAt              DateTime @default(now())

  @@index([unidadeId])
  @@map("kpi_snapshots")
}

// ─── Recursos Humanos (RH) ─────────────────────────────────────────────────

model Funcionario {
  id                 String    @id @default(uuid())
  userId             String    @unique
  instructorId       String?   @unique
  numeroFuncionario  String    @unique
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  biNumero           String?
  cargo              String // INSTRUTOR_NATACAO|SALVA_VIDAS|RECEPCIONISTA|ADMINISTRATIVO|COORDENADOR|MANUTENCAO|OUTRO
  departamento       String    @default("OPERACOES") // OPERACOES|ADMINISTRATIVO|FINANCEIRO|MANUTENCAO
  dataAdmissao       DateTime?
  estado             String    @default("EM_RECRUTAMENTO") // EM_RECRUTAMENTO|EM_ADMISSAO|ATIVO|FERIAS|SUSPENSO|DESLIGADO
  contactoEmergencia String?
  telefoneEmergencia String?
  salarioBase        Float?
  unidadeId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructor               Instructor?               @relation(fields: [instructorId], references: [id])
  unidade                  Unidade?                  @relation(fields: [unidadeId], references: [id])
  candidaturaOrigem        Candidatura?
  contratos                Contrato[]
  escalas                  Escala[]
  certificacoes            CertificacaoFuncionario[]
  avaliacoesDesempenho     AvaliacaoDesempenho[]
  feriasFaltas             FeriasFalta[]
  folhaPagamentos          FolhaPagamento[]
  ocorrenciasDisciplinares OcorrenciaDisciplinar[]
  documentos               DocumentoRH[]
  formacoes                FuncionarioFormacao[]
  desligamento             Desligamento?
  credenciaisBiometricas   CredencialBiometrica[]
  presencasBiometricas     RegistoPresenca[]

  @@index([estado])
  @@index([cargo])
  @@index([unidadeId])
  @@map("funcionarios")
}

model Vaga {
  id                String    @id @default(uuid())
  titulo            String
  cargo             String
  departamento      String    @default("OPERACOES")
  unidadeId         String?
  descricao         String    @db.Text
  requisitos        String?   @db.Text
  numeroVagas       Int       @default(1)
  orcamentoEstimado Float?
  estado            String    @default("RASCUNHO") // RASCUNHO|EM_APROVACAO|APROVADA|REJEITADA|PUBLICADA|EM_TRIAGEM|ENCERRADA|CANCELADA
  solicitanteId     String
  aprovadoPorId     String?
  aprovadoEm        DateTime?
  motivoRejeicao    String?   @db.Text
  publicadaEm       DateTime?
  encerradaEm       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  solicitante  User          @relation("VagaSolicitante", fields: [solicitanteId], references: [id])
  aprovadoPor  User?         @relation("VagaAprovada", fields: [aprovadoPorId], references: [id])
  unidade      Unidade?      @relation(fields: [unidadeId], references: [id])
  candidaturas Candidatura[]

  @@index([estado])
  @@map("rh_vagas")
}

model Candidatura {
  id               String    @id @default(uuid())
  vagaId           String
  nomeCandidato    String
  email            String?
  telefone         String?
  cvUrl            String?
  cartaMotivacao   String?   @db.Text
  estado           String    @default("RECEBIDA") // RECEBIDA|TRIAGEM|ENTREVISTA_AGENDADA|ENTREVISTADO|TESTE_PRATICO|APROVADA_RH|APROVADA_FINAL|REJEITADA|CONTRATADA
  notaEntrevista   Float?
  notaTestePratico Float?
  observacoesRH    String?   @db.Text
  avaliadoPorId    String?
  aprovadoPorId    String?
  aprovadoEm       DateTime?
  motivoRejeicao   String?   @db.Text
  funcionarioId    String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vaga        Vaga          @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  avaliadoPor User?         @relation("CandidaturaAvaliada", fields: [avaliadoPorId], references: [id])
  aprovadoPor User?         @relation("CandidaturaAprovada", fields: [aprovadoPorId], references: [id])
  funcionario Funcionario?  @relation(fields: [funcionarioId], references: [id])
  documentos  DocumentoRH[]

  @@index([estado])
  @@index([vagaId])
  @@map("rh_candidaturas")
}

model Contrato {
  id             String    @id @default(uuid())
  funcionarioId  String
  tipo           String // EFETIVO|TERMO_CERTO|TERMO_INCERTO|ESTAGIO|PRESTACAO_SERVICOS
  cargo          String
  salarioBase    Float
  dataInicio     DateTime
  dataFim        DateTime?
  clausulas      String?   @db.Text
  documentoUrl   String?
  estado         String    @default("RASCUNHO") // RASCUNHO|AGUARDA_ASSINATURA|ATIVO|EXPIRADO|RESCINDIDO|CANCELADO
  elaboradoPorId String
  assinadoPorId  String?
  assinadoEm     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  funcionario  Funcionario @relation(fields: [funcionarioId], references: [id])
  elaboradoPor User        @relation("ContratoElaborado", fields: [elaboradoPorId], references: [id])
  assinadoPor  User?       @relation("ContratoAssinado", fields: [assinadoPorId], references: [id])

  @@index([estado])
  @@index([funcionarioId])
  @@index([dataFim])
  @@map("rh_contratos")
}

model Escala {
  id            String   @id @default(uuid())
  funcionarioId String
  unidadeId     String?
  classId       String?
  data          DateTime
  turno         String // MANHA|TARDE|NOITE
  horaInicio    String
  horaFim       String
  tipo          String   @default("AULA") // AULA|SALVAMENTO|ADMINISTRATIVO|FORMACAO|FOLGA
  estado        String   @default("PLANEADA") // PLANEADA|CONFIRMADA|CANCELADA|REALIZADA
  observacoes   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  funcionario          Funcionario       @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  unidade              Unidade?          @relation(fields: [unidadeId], references: [id])
  presencasBiometricas RegistoPresenca[]

  @@index([funcionarioId])
  @@index([data])
  @@map("rh_escalas")
}

model CertificacaoFuncionario {
  id               String    @id @default(uuid())
  funcionarioId    String
  tipo             String // NADADOR_SALVADOR|INSTRUTOR_NATACAO|PRIMEIROS_SOCORROS|REGISTO_CRIMINAL|ATESTADO_APTIDAO_FISICA|OUTRO
  numeroDocumento  String?
  entidadeEmissora String?
  dataEmissao      DateTime?
  dataValidade     DateTime?
  documentoUrl     String?
  estado           String    @default("ATIVA") // ATIVA|EXPIRADA|REVOGADA
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([dataValidade])
  @@index([tipo])
  @@map("rh_certificacoes")
}

model AvaliacaoDesempenho {
  id                   String    @id @default(uuid())
  funcionarioId        String
  avaliadorId          String
  periodo              String
  dataAvaliacao        DateTime  @default(now())
  dataLimite           DateTime?
  pontualidade         Int?
  competenciaTecnica   Int?
  trabalhoEquipa       Int?
  atendimento          Int?
  pontuacaoGeral       Float?
  pontosFortes         String?   @db.Text
  areasMelhoria        String?   @db.Text
  planoDesenvolvimento String?   @db.Text
  estado               String    @default("PENDENTE") // PENDENTE|REALIZADA
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  avaliador   User        @relation(fields: [avaliadorId], references: [id])

  @@index([funcionarioId])
  @@index([estado])
  @@map("rh_avaliacoes_desempenho")
}

model FeriasFalta {
  id              String    @id @default(uuid())
  funcionarioId   String
  tipo            String // FERIAS|FALTA_JUSTIFICADA|FALTA_INJUSTIFICADA|LICENCA_MEDICA|LICENCA_MATERNIDADE|OUTRO
  dataInicio      DateTime
  dataFim         DateTime
  diasSolicitados Int
  motivo          String?   @db.Text
  documentoUrl    String?
  excepcional     Boolean   @default(false)
  estado          String    @default("PENDENTE") // PENDENTE|APROVADA_RH|ENCAMINHADA_SUPER_ADMIN|APROVADA_SUPER_ADMIN|REJEITADA|CANCELADA
  solicitanteId   String
  aprovadoPorId   String?
  aprovadoEm      DateTime?
  motivoRejeicao  String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  solicitante User        @relation("FeriasSolicitante", fields: [solicitanteId], references: [id])
  aprovadoPor User?       @relation("FeriasAprovada", fields: [aprovadoPorId], references: [id])

  @@index([estado])
  @@index([funcionarioId])
  @@map("rh_ferias_faltas")
}

model FolhaPagamento {
  id              String    @id @default(uuid())
  funcionarioId   String
  mes             Int
  ano             Int
  salarioBase     Float
  premios         Float     @default(0)
  descontos       Float     @default(0)
  horasExtras     Float     @default(0)
  valorLiquido    Float
  detalhes        String?   @db.Text
  estado          String    @default("RASCUNHO") // RASCUNHO|PENDENTE_APROVACAO|APROVADA|PAGA|REJEITADA
  processadoPorId String
  aprovadoPorId   String?
  aprovadoEm      DateTime?
  pagoEm          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  processadoPor User        @relation("FolhaProcessada", fields: [processadoPorId], references: [id])
  aprovadoPor   User?       @relation("FolhaAprovada", fields: [aprovadoPorId], references: [id])

  @@unique([funcionarioId, mes, ano])
  @@index([estado])
  @@map("rh_folha_pagamento")
}

model OcorrenciaDisciplinar {
  id             String    @id @default(uuid())
  funcionarioId  String
  data           DateTime  @default(now())
  tipo           String // ATRASO|ABSENTISMO|CONDUTA_INADEQUADA|VIOLACAO_SEGURANCA|REINCIDENCIA|OUTRO
  gravidade      String    @default("LEVE") // LEVE|MODERADA|GRAVE
  descricao      String    @db.Text
  medidaAplicada String?   @db.Text
  estado         String    @default("REGISTADA") // REGISTADA|EM_ANALISE|RESOLVIDA_RH|ESCALADA_SUPER_ADMIN|DECIDIDA_SUPER_ADMIN
  decisaoFinal   String? // ADVERTENCIA|SUSPENSAO|RESCISAO_JUSTA_CAUSA|SEM_ACAO
  registadoPorId String
  decididoPorId  String?
  decididoEm     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  funcionario  Funcionario @relation(fields: [funcionarioId], references: [id])
  registadoPor User        @relation("OcorrenciaRegistada", fields: [registadoPorId], references: [id])
  decididoPor  User?       @relation("OcorrenciaDecidida", fields: [decididoPorId], references: [id])

  @@index([gravidade])
  @@index([estado])
  @@index([funcionarioId])
  @@map("rh_ocorrencias_disciplinares")
}

model Formacao {
  id            String    @id @default(uuid())
  titulo        String
  tipo          String // RECICLAGEM|CERTIFICACAO|SOFT_SKILLS|SEGURANCA|OUTRO
  descricao     String?   @db.Text
  custoEstimado Float?
  dataInicio    DateTime?
  dataFim       DateTime?
  estado        String    @default("PROPOSTA") // PROPOSTA|APROVADA_ORCAMENTO|REJEITADA|EM_CURSO|CONCLUIDA|CANCELADA
  propostoPorId String
  aprovadoPorId String?
  aprovadoEm    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  propostoPor   User                  @relation("FormacaoProposta", fields: [propostoPorId], references: [id])
  aprovadoPor   User?                 @relation("FormacaoAprovada", fields: [aprovadoPorId], references: [id])
  participantes FuncionarioFormacao[]

  @@index([estado])
  @@map("rh_formacoes")
}

model FuncionarioFormacao {
  id             String   @id @default(uuid())
  formacaoId     String
  funcionarioId  String
  estado         String   @default("INSCRITO") // INSCRITO|CONCLUIDO|DESISTIU
  notaFinal      Float?
  certificadoUrl String?
  createdAt      DateTime @default(now())

  formacao    Formacao    @relation(fields: [formacaoId], references: [id], onDelete: Cascade)
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([formacaoId, funcionarioId])
  @@map("rh_funcionario_formacoes")
}

model DocumentoRH {
  id            String    @id @default(uuid())
  funcionarioId String?
  candidaturaId String?
  tipo          String // BI|CERTIFICADO_NADADOR_SALVADOR|CERTIFICADO_INSTRUTOR|REGISTO_CRIMINAL|ATESTADO_APTIDAO_FISICA|CONTRATO|CV|OUTRO
  nome          String
  url           String
  size          Int?
  validado      Boolean   @default(false)
  validadoPorId String?
  validadoEm    DateTime?
  uploadedAt    DateTime  @default(now())

  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id])
  candidatura Candidatura? @relation(fields: [candidaturaId], references: [id])
  validadoPor User?        @relation(fields: [validadoPorId], references: [id])

  @@index([funcionarioId])
  @@map("rh_documentos")
}

model Desligamento {
  id                   String    @id @default(uuid())
  funcionarioId        String    @unique
  tipo                 String // DEMISSAO_VOLUNTARIA|DESPEDIMENTO_SEM_JUSTA_CAUSA|DESPEDIMENTO_JUSTA_CAUSA|FIM_CONTRATO|REFORMA
  motivo               String?   @db.Text
  dataInicioProcesso   DateTime  @default(now())
  dataSaida            DateTime?
  avisoPrevioDias      Int?
  valorAcertoContas    Float?
  detalhesAcerto       String?   @db.Text
  estado               String    @default("INICIADO") // INICIADO|AGUARDA_APROVACAO|APROVADO|REJEITADO|CONCLUIDO
  iniciadoPorId        String
  aprovadoPorId        String?
  aprovadoEm           DateTime?
  acessosDesativadosEm DateTime?
  arquivadoEm          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])
  iniciadoPor User        @relation("DesligamentoIniciado", fields: [iniciadoPorId], references: [id])
  aprovadoPor User?       @relation("DesligamentoAprovado", fields: [aprovadoPorId], references: [id])

  @@index([estado])
  @@map("rh_desligamentos")
}

// ─── Presença Biométrica ─────────────────────────────────────────────────

model DispositivoQuiosque {
  id           String    @id @default(uuid())
  nome         String
  unidadeId    String
  chaveHash    String    @db.VarChar(255)
  ultimoAcesso DateTime?
  ativo        Boolean   @default(true)
  criadoPorId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  unidade             Unidade                @relation(fields: [unidadeId], references: [id])
  criadoPor           User                   @relation("DispositivoCriado", fields: [criadoPorId], references: [id])
  credenciaisWebauthn CredencialBiometrica[] @relation("CredencialDispositivo")
  registosPresenca    RegistoPresenca[]

  @@index([unidadeId])
  @@index([ativo])
  @@map("rh_dispositivos_quiosque")
}

model CredencialBiometrica {
  id            String  @id @default(uuid())
  funcionarioId String
  tipo          String // WEBAUTHN | USB_TEMPLATE
  dispositivoId String? // obrigatório para WEBAUTHN (credencial ligada a um quiosque físico); null para USB_TEMPLATE

  // --- campos específicos WEBAUTHN ---
  credentialId String? @unique @db.VarChar(512)
  publicKey    String? @db.Text
  counter      BigInt? @default(0)
  transports   String? // JSON stringificado, ex. ["internal"]
  deviceLabel  String?

  // --- campos específicos USB_TEMPLATE ---
  fabricante      String?
  templateData    Bytes?  @db.LongBlob
  templateFormato String?

  ativo            Boolean   @default(true)
  registadoEm      DateTime  @default(now())
  ultimaUtilizacao DateTime?

  funcionario Funcionario          @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  dispositivo DispositivoQuiosque? @relation("CredencialDispositivo", fields: [dispositivoId], references: [id])

  @@index([funcionarioId])
  @@index([tipo])
  @@index([dispositivoId])
  @@map("rh_credenciais_biometricas")
}

model RegistoPresenca {
  id                 String   @id @default(uuid())
  funcionarioId      String
  dispositivoId      String?
  unidadeId          String?
  escalaId           String?
  tipo               String // ENTRADA | SAIDA
  metodoVerificacao  String // WEBAUTHN | USB_TEMPLATE | MANUAL
  timestamp          DateTime @default(now())
  lancadoManualmente Boolean  @default(false)
  responsavelId      String?
  observacao         String?  @db.Text

  funcionario Funcionario          @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  dispositivo DispositivoQuiosque? @relation(fields: [dispositivoId], references: [id])
  unidade     Unidade?             @relation(fields: [unidadeId], references: [id])
  escala      Escala?              @relation(fields: [escalaId], references: [id])
  responsavel User?                @relation("PresencaLancadaManualmente", fields: [responsavelId], references: [id])

  @@index([funcionarioId])
  @@index([dispositivoId])
  @@index([timestamp])
  @@index([funcionarioId, timestamp])
  @@map("rh_presencas_biometricas")
}
