generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String    @db.VarChar(255)
  role          String    // ADMIN | SUPERVISOR | INSTRUCTOR | COORDINATOR | STUDENT | PARENT | MARKETING | VISITOR
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  refreshToken  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admin              Admin?
  instructor         Instructor?
  student            Student?
  parent             Parent?
  notifications      Notification[]
  auditLogs          AuditLog[]
  incidentesReportados Incidente[] @relation("IncidenteReportado")
  pedidosComunicacao  PedidoComunicacao[] @relation("PedidoSolicitante")
  pedidosAprovados    PedidoComunicacao[] @relation("PedidoAprovado")
  certificadosValidados Certificado[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ─── Instructor ───────────────────────────────────────────────────────────────

model Instructor {
  id              String    @id @default(uuid())
  userId          String    @unique
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  specializations String    @default("[]") @db.Text
  bio             String?   @db.Text
  isActive        Boolean   @default(true)
  hireDate        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes         Class[]
  attendances     Attendance[]
  feedbacks       Feedback[]
  trainingPlans   TrainingPlan[]
  avaliacoesIniciais AvaliacaoInicial[]
  unidades        InstructorUnidade[]
  checklistsProtocolo ChecklistProtocolo[]

  @@index([isActive])
  @@map("instructors")
}

// ─── Student ─────────────────────────────────────────────────────────────────

model Student {
  id                   String    @id @default(uuid())
  userId               String    @unique
  firstName            String
  lastName             String
  dateOfBirth          DateTime
  gender               String    @default("OTHER")
  phone                String?
  avatarUrl            String?
  medicalNotes         String?   @db.Text
  emergencyContact     String?
  emergencyPhone       String?
  enrollmentDate       DateTime  @default(now())
  isActive             Boolean   @default(true)
  unidadeId            String?
  autorizacaoImagem    Boolean   @default(false)
  autorizacaoImagemData DateTime?
  autorizacaoImagemDoc String?
  leadId               String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unidade          Unidade?  @relation(fields: [unidadeId], references: [id])
  lead             Lead?     @relation(fields: [leadId], references: [id])
  parents          StudentParent[]
  enrollments      Enrollment[]
  attendances      Attendance[]
  feedbacks        Feedback[]
  progressRecords  Progress[]
  studentFases     StudentFase[]
  certificados     Certificado[]
  trainingPlans    TrainingPlan[]
  payments         Payment[]
  monthlyFees      MonthlyFee[]
  documents        Document[]
  avaliacaoInicial AvaliacaoInicial?
  competicoes      CompeticaoAtleta[]

  @@index([isActive])
  @@index([unidadeId])
  @@map("students")
}

// ─── Parent ───────────────────────────────────────────────────────────────────

model Parent {
  id           String    @id @default(uuid())
  userId       String    @unique
  firstName    String
  lastName     String
  phone        String
  relationship String    @default("Parent")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  children     StudentParent[]

  @@map("parents")
}

model StudentParent {
  studentId String
  parentId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@map("student_parents")
}

// ─── Unidade (Multi-Unit) ────────────────────────────────────────────────────

model Unidade {
  id        String   @id @default(uuid())
  nome      String
  codigo    String   @unique   // CCBM | OSCARS | POLANA
  tipo      String   @default("PRINCIPAL") // PRINCIPAL | COMUNITARIO | PREMIUM
  endereco  String?
  contacto  String?
  email     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turmas       Class[]
  estudantes   Student[]
  instrutores  InstructorUnidade[]
  leads        Lead[]
  incidentes   Incidente[]
  eventos      Evento[]
  competicoes  Competicao[]

  @@map("unidades")
}

model InstructorUnidade {
  id          String   @id @default(uuid())
  instrutorId String
  unidadeId   String
  isPrimary   Boolean  @default(false)
  criadoEm   DateTime @default(now())

  instrutor   Instructor @relation(fields: [instrutorId], references: [id], onDelete: Cascade)
  unidade     Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([instrutorId, unidadeId])
  @@map("instructor_unidades")
}

// ─── Lead / CRM ──────────────────────────────────────────────────────────────

model Lead {
  id               String    @id @default(uuid())
  nome             String
  email            String?
  telefone         String?
  origem           String    @default("OUTRO") // REFERIDO|REDES_SOCIAIS|OPEN_DAY|WALK_IN|WEBSITE|CAMPANHA|OUTRO
  campanha         String?
  estado           String    @default("NOVO") // NOVO|CONTACTADO|AGENDADO|CONVERTIDO|PERDIDO
  unidadeId        String?
  eventoId         String?
  notas            String?   @db.Text
  dataContacto     DateTime?
  dataAgendamento  DateTime?
  dataConversao    DateTime?
  motivoPerda      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  unidade  Unidade? @relation(fields: [unidadeId], references: [id])
  evento   Evento?  @relation(fields: [eventoId], references: [id])
  student  Student?

  @@index([estado])
  @@index([unidadeId])
  @@map("leads")
}

// ─── Avaliação Inicial ────────────────────────────────────────────────────────

model AvaliacaoInicial {
  id                    String    @id @default(uuid())
  studentId             String    @unique
  instrutorId           String
  data                  DateTime  @default(now())
  experienciaAquatica   Int       @default(1)  // 1-5
  segurancaAdaptacao    Int       @default(1)  // 1-5
  confortoAgua          Int       @default(1)  // 1-5
  resistenciaBasica     Int       @default(1)  // 1-5
  necessidadesEspeciais String?   @db.Text
  observacoes           String?   @db.Text
  faseRecomendadaId     String?
  aprovadoPorId         String?
  aprovadoEm            DateTime?
  createdAt             DateTime  @default(now())

  student           Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instrutor         Instructor     @relation(fields: [instrutorId], references: [id])
  faseRecomendada   FaseProgressao? @relation(fields: [faseRecomendadaId], references: [id])

  @@map("avaliacoes_iniciais")
}

// ─── Fases de Progressão (9 fases com animais) ───────────────────────────────

model FaseProgressao {
  id            String   @id @default(uuid())
  nivel         String   // AMA | INTERMEDIARIO | AVANCADO
  ordem         Int
  nome          String   // Estrela-do-Mar, Cavalo-Marinho, etc.
  animal        String
  certificacao  String   // BRONZE | PRATA | OURO
  descricao     String?  @db.Text
  criterios     String   @default("[]") @db.Text // JSON array of criteria
  assiduidade   Int      @default(80) // minimum attendance % required
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  studentFases       StudentFase[]
  certificados       Certificado[]
  avaliacoesIniciais AvaliacaoInicial[]

  @@unique([nivel, ordem])
  @@map("fases_progressao")
}

model StudentFase {
  id          String    @id @default(uuid())
  studentId   String
  faseId      String
  estado      String    @default("NAO_INICIADO") // NAO_INICIADO|EM_PROGRESSO|CONCLUIDO
  iniciadoEm  DateTime?
  concluidoEm DateTime?
  pontuacao   Float?
  notas       String?   @db.Text
  updatedAt   DateTime  @updatedAt

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fase    FaseProgressao @relation(fields: [faseId], references: [id])

  @@unique([studentId, faseId])
  @@index([studentId])
  @@map("student_fases")
}

model Certificado {
  id              String   @id @default(uuid())
  studentId       String
  faseId          String
  dataEmissao     DateTime @default(now())
  validadoPorId   String
  eventoId        String?
  numeroSerie     String   @unique
  observacoes     String?  @db.Text
  createdAt       DateTime @default(now())

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fase        FaseProgressao @relation(fields: [faseId], references: [id])
  validadoPor User           @relation(fields: [validadoPorId], references: [id])
  evento      Evento?        @relation(fields: [eventoId], references: [id])

  @@index([studentId])
  @@map("certificados")
}

// ─── Classes ─────────────────────────────────────────────────────────────────

model Class {
  id           String   @id @default(uuid())
  name         String
  description  String?  @db.Text
  level        String   @default("BEGINNER")
  status       String   @default("ACTIVE")
  maxStudents  Int      @default(15)
  poolLane     String?
  schedules    String   @default("[]") @db.Text
  instructorId String
  unidadeId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor   Instructor   @relation(fields: [instructorId], references: [id])
  unidade      Unidade?     @relation(fields: [unidadeId], references: [id])
  enrollments  Enrollment[]
  sessions     ClassSession[]

  @@index([status])
  @@index([instructorId])
  @@index([unidadeId])
  @@map("classes")
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  classId    String
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)
  notes      String?  @db.Text

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([isActive])
  @@map("enrollments")
}

// ─── Class Sessions & Attendance ─────────────────────────────────────────────

model ClassSession {
  id                    String   @id @default(uuid())
  classId               String
  sessionDate           DateTime
  startTime             String
  endTime               String
  notes                 String?  @db.Text
  topic                 String?
  checklistEquipamentos Boolean  @default(false)
  checklistSeguranca    Boolean  @default(false)
  createdAt             DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  feedbacks   Feedback[]
  checklists  ChecklistProtocolo[]

  @@index([classId])
  @@map("class_sessions")
}

model Attendance {
  id           String   @id @default(uuid())
  sessionId    String
  studentId    String
  instructorId String
  status       String   @default("PRESENT")
  notes        String?  @db.Text
  markedAt     DateTime @default(now())

  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor   Instructor   @relation(fields: [instructorId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendances")
}

// ─── Performance & Feedback ──────────────────────────────────────────────────

model PerformanceRecord {
  id              String   @id @default(uuid())
  studentId       String
  sessionId       String?
  instructorId    String?
  technique       Int?
  stamina         Int?
  speed           Int?
  coordination    Int?
  breathing       Int?
  turns           Int?
  startDive       Int?
  overallScore    Float?
  instructorNotes String?  @db.Text
  acaoCorretiva   String?  @db.Text
  rawData         String?  @db.Text
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  feedback        Feedback?

  @@index([studentId])
  @@map("performance_records")
}

model Feedback {
  id                   String   @id @default(uuid())
  studentId            String
  sessionId            String?
  instructorId         String?
  performanceRecordId  String?  @unique
  status               String   @default("PENDING")
  aiGeneratedText      String?  @db.LongText
  instructorNotes      String?  @db.Text
  finalText            String?  @db.LongText
  recommendedLessons   String   @default("[]") @db.Text
  interactiveExercises String   @default("[]") @db.Text
  sentToParentAt       DateTime?
  sentToStudentAt      DateTime?
  aiModel              String?
  aiTokensUsed         Int?
  aiConfidenceScore    Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session             ClassSession?      @relation(fields: [sessionId], references: [id])
  instructor          Instructor?        @relation(fields: [instructorId], references: [id])
  performanceRecord   PerformanceRecord? @relation(fields: [performanceRecordId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("feedbacks")
}

// ─── Progress & Modules ──────────────────────────────────────────────────────

model SwimmingModule {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  level       String   @default("BEGINNER")
  order       Int
  skills      String   @default("[]") @db.Text
  videos      String   @default("[]") @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  progress    Progress[]

  @@map("swimming_modules")
}

model Progress {
  id          String    @id @default(uuid())
  studentId   String
  moduleId    String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  score       Float?
  notes       String?   @db.Text
  updatedAt   DateTime  @updatedAt

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      SwimmingModule @relation(fields: [moduleId], references: [id])

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@map("progress")
}

// ─── Training Plans ───────────────────────────────────────────────────────────

model TrainingPlan {
  id           String    @id @default(uuid())
  studentId    String
  instructorId String?
  title        String
  description  String?   @db.Text
  objectives   String    @default("[]") @db.Text
  exercises    String    @default("[]") @db.Text
  aiGenerated  Boolean   @default(false)
  isActive     Boolean   @default(true)
  validFrom    DateTime
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor   Instructor? @relation(fields: [instructorId], references: [id])

  @@index([studentId])
  @@map("training_plans")
}

// ─── Financial ───────────────────────────────────────────────────────────────

model MonthlyFee {
  id          String   @id @default(uuid())
  studentId   String
  month       Int
  year        Int
  amount      Float
  dueDate     DateTime
  description String?
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment     Payment?

  @@unique([studentId, month, year])
  @@index([studentId])
  @@map("monthly_fees")
}

model Payment {
  id            String    @id @default(uuid())
  studentId     String
  monthlyFeeId  String?   @unique
  amount        Float
  method        String    @default("CASH")
  status        String    @default("PENDING")
  reference     String?
  receiptNumber String?   @unique
  notes         String?   @db.Text
  paidAt        DateTime?
  dueDate       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthlyFee    MonthlyFee? @relation(fields: [monthlyFeeId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("payments")
}

// ─── Protocolos de Segurança (SOP 09 — Documento Consolidado Jun/2026) ────────

model Protocolo {
  id               String   @id @default(uuid())
  ranking          Int      @unique  // 1–10 (prioridade oficial)
  nome             String
  dimensao         String   // FISICA|OPERACIONAL|EMOCIONAL|PEDAGOGICA|GESTAO
  prioridade       String   // CRITICO|MUITO_ALTO|ALTO|ESTRUTURANTE
  justificacao     String   @db.Text
  objetivo         String   @db.Text
  momentoAplicacao String   @db.Text
  responsavel      String
  procedimento     String   @db.Text
  checklistItems   String   @default("[]") @db.Text  // JSON string[]
  sinaisAlerta     String   @default("[]") @db.Text  // JSON string[]
  acaoFalha        String   @db.Text
  isRelampago      Boolean  @default(false)           // true só no Protocolo 1
  isAtivo          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  incidentes Incidente[]
  checklists ChecklistProtocolo[]

  @@index([ranking])
  @@index([dimensao])
  @@map("protocolos")
}

model ChecklistProtocolo {
  id          String    @id @default(uuid())
  protocoloId String
  sessionId   String?
  instrutorId String
  items       String    @db.Text  // JSON [{texto, checked}]
  completado  Boolean   @default(false)
  data        DateTime  @default(now())
  observacoes String?   @db.Text
  createdAt   DateTime  @default(now())

  protocolo Protocolo    @relation(fields: [protocoloId], references: [id])
  session   ClassSession? @relation(fields: [sessionId], references: [id])
  instrutor Instructor   @relation(fields: [instrutorId], references: [id])

  @@index([protocoloId])
  @@index([instrutorId])
  @@map("checklists_protocolo")
}

// ─── Gestão de Incidentes e Segurança (SOP 09) ───────────────────────────────

model Incidente {
  id               String    @id @default(uuid())
  unidadeId        String?
  data             DateTime  @default(now())
  tipo             String    // ACIDENTE_MENOR|ACIDENTE_GRAVE|NEAR_MISS|COMPORTAMENTO|EQUIPAMENTO|INSTALACOES|OUTRO
  tipoOcorrencia   String    @default("INCIDENTE_CONFIRMADO") // INCIDENTE_CONFIRMADO|QUASE_INCIDENTE
  dimensoes        String    @default("[]") @db.Text  // JSON: EMOCIONAL|OPERACIONAL|FISICA|PEDAGOGICA
  protocoloId      String?
  isRelampago      Boolean   @default(false)
  escalado         Boolean   @default(false)
  descricao        String    @db.Text
  envolvidos       String    @default("[]") @db.Text // JSON
  acaoImediata     String    @db.Text
  relatorio        String?   @db.Text
  acoesPreventivas String?   @db.Text
  estado           String    @default("REPORTADO") // REPORTADO|EM_INVESTIGACAO|RESOLVIDO|FECHADO
  reportadoPorId   String
  resolvidoEm      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  unidade      Unidade?   @relation(fields: [unidadeId], references: [id])
  reportadoPor User       @relation("IncidenteReportado", fields: [reportadoPorId], references: [id])
  protocolo    Protocolo? @relation(fields: [protocoloId], references: [id])

  @@index([estado])
  @@index([unidadeId])
  @@index([tipoOcorrencia])
  @@index([protocoloId])
  @@map("incidentes")
}

// ─── Eventos / Open Day (SOP 07) ─────────────────────────────────────────────

model Evento {
  id         String   @id @default(uuid())
  tipo       String   @default("OPEN_DAY") // OPEN_DAY|COMPETICAO|OUTRO
  nome       String
  data       DateTime
  unidadeId  String?
  programa   String?  @db.Text
  capacidade Int?
  estado     String   @default("PLANEADO") // PLANEADO|REALIZADO|CANCELADO
  notas      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unidade     Unidade?     @relation(fields: [unidadeId], references: [id])
  certificados Certificado[]
  leads        Lead[]

  @@index([tipo])
  @@index([estado])
  @@map("eventos")
}

// ─── Competições (SOP 08) ─────────────────────────────────────────────────────

model Competicao {
  id               String   @id @default(uuid())
  nome             String
  data             DateTime
  local            String
  unidadeId        String?
  descricao        String?  @db.Text
  planoCompetitivo String?  @db.Text
  estado           String   @default("PLANEADA") // PLANEADA|REALIZADA|CANCELADA
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unidade  Unidade?          @relation(fields: [unidadeId], references: [id])
  atletas  CompeticaoAtleta[]

  @@index([estado])
  @@map("competicoes")
}

model CompeticaoAtleta {
  id           String  @id @default(uuid())
  competicaoId String
  studentId    String
  prova        String?
  resultado    String?
  posicao      Int?
  notas        String? @db.Text

  competicao Competicao @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([competicaoId, studentId])
  @@map("competicao_atletas")
}

// ─── Pedidos de Comunicação / Marketing (SOP 9.3–9.7) ────────────────────────

model PedidoComunicacao {
  id            String   @id @default(uuid())
  tipo          String   // POSTER|VIDEO|NEWSLETTER|REDES_SOCIAIS|CATALOGO|OUTRO
  titulo        String
  descricao     String   @db.Text
  unidadeId     String?
  prazo         DateTime
  estado        String   @default("RASCUNHO") // RASCUNHO|EM_APROVACAO|APROVADO|PUBLICADO|CANCELADO
  solicitanteId String
  aprovadoPorId String?
  aprovadoEm    DateTime?
  link          String?
  observacoes   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  solicitante User  @relation("PedidoSolicitante", fields: [solicitanteId], references: [id])
  aprovadoPor User? @relation("PedidoAprovado", fields: [aprovadoPorId], references: [id])

  @@index([estado])
  @@map("pedidos_comunicacao")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("INFO")
  title     String
  body      String    @db.Text
  data      String?   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(uuid())
  studentId  String
  name       String
  type       String
  url        String
  size       Int?
  uploadedAt DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("documents")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValues String?  @db.Text
  newValues String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

// ─── KPI Snapshots ───────────────────────────────────────────────────────────

model KpiSnapshot {
  id                     String   @id @default(uuid())
  unidadeId              String?
  snapshotDate           DateTime @default(now())
  totalStudents          Int
  activeStudents         Int
  totalInstructors       Int
  totalClasses           Int
  attendanceRate         Float
  avgFeedbackScore       Float?
  npsScore               Float?
  instructorAdoptionRate Float?
  overduePayments        Int
  monthlyRevenue         Float?
  leadsGerados           Int?
  conversaoLead          Float?
  incidentesCount        Int      @default(0)
  participacaoOpenDay    Float?
  createdAt              DateTime @default(now())

  @@index([unidadeId])
  @@map("kpi_snapshots")
}
