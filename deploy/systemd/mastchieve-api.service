# Mastchieve IA — API (NestJS)
#
# Instalar:
#   sudo cp deploy/systemd/mastchieve-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable mastchieve-api
#   sudo systemctl start mastchieve-api
#
# Gerir:
#   sudo systemctl restart mastchieve-api
#   sudo systemctl status mastchieve-api
#   journalctl -u mastchieve-api -f

[Unit]
Description=Mastchieve IA - API (NestJS)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mastchieve/apps/api
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
