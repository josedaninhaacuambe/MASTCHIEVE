# Mastchieve IA — Web (Next.js, a correr em Docker)
#
# Instalar:
#   sudo cp deploy/systemd/mastchieve-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable mastchieve-web
#   sudo systemctl start mastchieve-web
#
# Gerir:
#   sudo systemctl restart mastchieve-web
#   sudo systemctl status mastchieve-web
#   docker compose -f /var/www/mastchieve/docker-compose.prod.yml logs -f web

[Unit]
Description=Mastchieve IA - Web (Docker Compose)
Requires=docker.service
After=docker.service network-online.target mastchieve-backend.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/mastchieve
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d --no-deps web
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml stop web
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
